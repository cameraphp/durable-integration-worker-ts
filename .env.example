# Non-secret local settings only. Copy to .env if you want to override defaults.
# The API always binds to 127.0.0.1.
PORT=3000
RUNTIME_DIR=.runtime
MAX_ATTEMPTS=4
JOB_TIMEOUT_MS=2000
BASE_BACKOFF_MS=1000
MAX_BACKOFF_MS=30000
STALE_LOCK_MS=30000
LOCK_ACQUIRE_TIMEOUT_MS=5000
WORKER_BATCH_SIZE=10
LOG_LEVEL=info
MOCK_SCENARIOS_ENABLED=false
