{
  "name": "durable-integration-worker-ts",
  "version": "0.1.0",
  "description": "Tested local reference implementation of durable, idempotency-aware, at-least-once webhook processing (single host, local-file journal, mock adapters).",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:safety": "node scripts/safety-check.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prestart:api": "npm run build --silent",
    "start:api": "node --env-file-if-exists=.env dist/cli/api.js",
    "preworker:once": "npm run build --silent",
    "worker:once": "node --env-file-if-exists=.env dist/cli/worker.js --once",
    "prereplay:dead-letter": "npm run build --silent",
    "replay:dead-letter": "node --env-file-if-exists=.env dist/cli/replay.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
